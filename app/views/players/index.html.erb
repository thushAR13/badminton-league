<h1>Manage Players</h1>

<div style="margin-bottom: 30px; padding: 15px; border: 1px solid #ccc; max-width: 400px;">
  <h3>Add a New Player</h3>
  
  <%= form_with model: @new_player, url: players_path do |form| %>
    <% if @new_player.errors.any? %>
      <div style="color: red; margin-bottom: 10px;">
        <%= @new_player.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.text_field :name, placeholder: "Enter player name...", required: true %>
      <%= form.submit "Add Player" %>
    </div>
  <% end %>
</div>

<h3>Current Roster</h3>
<table border="1" cellpadding="8" cellspacing="0">
  <thead>
    <tr>
      <th>Name</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @players.each do |player| %>
      <tr>
        <td><%= player.name %></td>
        <td>
          <%= link_to "Remove", player_path(player),data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will delete their match history too." } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<%= link_to "← Back to Leaderboard", root_path %>