<h1>Match History</h1>

<div style="margin-bottom: 20px;">
  <%= link_to "Back to Leaderboard", root_path %> | 
  <%= link_to "Record a Match", new_match_path %>
</div>

<table class="table table-striped table-hover table-bordered">  <thead>
    <tr style="background-color: #f4f4f4;">
      <th>Date</th>
      <th>Winner</th>
      <th>Loser</th>
    </tr>
  </thead>
  <tbody>
    <% if @matches.any? %>
      <% @matches.each do |match| %>
        <tr>
          <td><%= match.created_at.strftime("%b %d, %Y") %></td>
          <td style="color: green;"><strong><%= match.winner.name %></strong></td>
          <td style="color: red;"><%= match.loser.name %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="3" style="text-align: center;">No matches have been played yet.</td>
      </tr>
    <% end %>
  </tbody>
</table>