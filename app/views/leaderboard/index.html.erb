<h1>Badminton League Leaderboard</h1>

<div style="margin-bottom: 20px;">
  <%= link_to "Record a Match", new_match_path, class: "btn btn-outline-primary" %>
  <%= link_to "Manage Players", players_path, class: "btn btn-outline-primary" %>
  <%= link_to "Match History", matches_path, class: "btn btn-outline-primary" %>
</div>

<table class="table table-striped table-hover table-bordered">
  <thead>
    <tr style="background-color: #f4f4f4;">
      <th>Rank</th>
      <th>Player</th>
      <th>Wins</th>
      <th>Losses</th>
    </tr>
  </thead>
  <tbody>
    <% if @players.any? %>
      <% @players.each_with_index do |player, index| %>
        <tr>
          <td><%= index + 1 %></td>
          <td><strong><%= player.name %></strong></td>
          <td style="color: green;"><%= player.wins %></td>
          <td style="color: red;"><%= player.losses %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="4" style="text-align: center;">No players in the league yet. Go add some!</td>
      </tr>
    <% end %>
  </tbody>
</table>