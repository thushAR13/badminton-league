<h1>Badminton League Leaderboard</h1>

<div style="margin-bottom: 20px;">
  <%= link_to "Record a Match", new_match_path, style: "font-weight: bold; margin-right: 15px;" %>
  <%= link_to "Manage Players", players_path %> |
  <%= link_to "Match History", matches_path %>
</div>

<table border="1" cellpadding="10" cellspacing="0" style="width: 100%; max-width: 600px; text-align: left;">
  <thead>
    <tr style="background-color: #f4f4f4;">
      <th>Rank</th>
      <th>Player</th>
      <th>Wins</th>
      <th>Losses</th>
    </tr>
  </thead>
  <tbody>
    <% if @players.any? %>
      <% @players.each_with_index do |player, index| %>
        <tr>
          <td><%= index + 1 %></td>
          <td><strong><%= player.name %></strong></td>
          <td style="color: green;"><%= player.wins %></td>
          <td style="color: red;"><%= player.losses %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="4" style="text-align: center;">No players in the league yet. Go add some!</td>
      </tr>
    <% end %>
  </tbody>
</table>